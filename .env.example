# KaayLeek Server Configuration
# Copy this file to .env and fill in the values

# Server port (default: 3000)
PORT=3000

# JWT secret key (auto-generated if not set — required for multi-instance)
JWT_SECRET=your-super-secret-key-here

# Admin credentials (default: admin / admin123)
ADMIN_USER=admin
ADMIN_PASS=your-secure-password

# Node environment (production enables secure cookies)
NODE_ENV=production

# Base de données cloud (Turso/libSQL) — OBLIGATOIRE pour la persistance en production
# Créez une base gratuite sur https://console.turso.tech puis remplissez :
TURSO_URL=libsql://kaayleek-xxxx.turso.io
TURSO_TOKEN=eyJhbGciOi...
# Sans ces variables, le serveur utilise une base SQLite locale (les données sont perdues au redémarrage sur Render).

# Chemin du fichier SQLite local (optionnel, fallback local uniquement)
# DB_PATH=/path/to/kaayleek.db
